# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.tools/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-desktop/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory

# local agent tooling state
/.claude/
/.spec-workflow/

# generated macOS desktop bundle inputs and Rust build output
/src-tauri/gen/
/src-tauri/resources/Pi Web Server.app/
/src-tauri/resources/Pi Agent Server.app/
/src-tauri/resources/server/
/src-tauri/resources/node/
/src-tauri/target/

# portable Pi profile: keep settings and authored resources, ignore local state and downloads
/.pi/
/.pi-agent/npm/
/.pi-agent/git/
/.pi-agent/auth.json
/.pi-agent/oauth.json
/.pi-agent/trust.json
/.pi-agent/models.json
/.pi-agent/models-store.json
/.pi-agent/sessions/
